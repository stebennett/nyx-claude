#!/usr/bin/env bash
# Directory-aware `gh` shim. Inside a repo that opted into GitHub App identity
# (`git config gh-app.enabled` == true), run gh authenticated as the App, aborting
# rather than falling back to personal auth on token failure. Everywhere else, pass
# through to the real gh unchanged. See the github-app-identity setup runbook.
set -euo pipefail

dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=gh-app-common.sh
. "$dir/gh-app-common.sh"

# Resolve the real gh: the first gh on PATH that is not this shim (overridable for tests).
resolve_real_gh() {
  if [[ -n "${GH_APP_REAL_GH:-}" ]]; then printf '%s\n' "$GH_APP_REAL_GH"; return 0; fi
  local self="$dir/gh" p cand cdir
  local IFS=:
  for p in $PATH; do
    cand="$p/gh"
    [[ -x "$cand" ]] || continue
    cdir="$(cd "$(dirname "$cand")" 2>/dev/null && pwd)" || continue
    [[ "$cdir/gh" != "$self" ]] && { printf '%s\n' "$cand"; return 0; }
  done
  echo "gh-app shim: no real gh found on PATH" >&2
  return 1
}

real_gh="$(resolve_real_gh)"

# Which identity governs this directory? Empty means pass through untouched.
profile="$(gh_app_resolve_profile)" || exit 1
if [ -z "$profile" ]; then
  exec "$real_gh" "$@"
fi

token="$("${GITHUB_APP_TOKEN_CMD:-$dir/github-app-token.sh}" --profile "$profile")" \
  || gh_app_die "could not mint a token for profile '$profile'. $GH_APP_DOCTRINE"
[ -n "$token" ] \
  || gh_app_die "empty token for profile '$profile' — refusing to run, because gh would fall back to personal auth. $GH_APP_DOCTRINE"

[ -n "${GH_APP_DEBUG:-}" ] && echo "gh-app shim: running gh as profile '$profile'" >&2
GH_TOKEN="$token" exec "$real_gh" "$@"
